{%- comment -%}
  Banner Drop Bicapa de la página de inicio.
  Lo muestra la sección "Banner Drop Bicapa" (Liquid personalizado, arriba de todo en la portada),
  que solo tiene: {% render 'drop-bicapa-banner' %}
  Antes de la apertura: "Anotate" + cuenta regresiva. Después: "Ya están disponibles".
  La fecha sale del metacampo de la tienda drop_bicapa.start (si no existe, 25/10 00:00).
  Si el producto se agota: "Se agotaron" y lleva a anotarse al próximo drop.
  En el celular es una franja compacta con la foto de fondo, para que se vea el resto de la portada.
{%- endcomment -%}
{%- assign rrdb_p = all_products['bicapa-edicion-especial'] -%}
{%- assign rrdb_start = shop.metafields.drop_bicapa.start.value | default: '2026-10-25T00:00-03:00' -%}
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet">
<a class="rrdb" id="rrdb" href="/pages/drop-bicapa?utm_source=tienda&utm_medium=banner&utm_campaign=drop-bicapa"
   data-start="{{ rrdb_start | escape }}"
   data-soldout="{% if rrdb_p != blank and rrdb_p.available == false %}1{% else %}0{% endif %}">
  <span class="rrdb__media">
    <img src="https://cdn.shopify.com/s/files/1/0739/7903/5800/files/bicapa-portada.jpg?v=1791223612&width=1200"
         alt="Puros bicapa Ramón Ramírez" width="1200" height="675" loading="eager">
  </span>
  <span class="rrdb__body">
    <span class="rrdb__kicker">Edición especial · Stock limitado</span>
    <span class="rrdb__title" data-t>Anotate a los <em>bicapa</em></span>
    <span class="rrdb__sub" data-s>Dos capas elegidas hoja por hoja y 6 meses en ron. Abre el <span data-when>domingo 25 a las 00:00</span> y los anotados se enteran primero.</span>
    <span class="rrdb__when">Abre el <span data-when>domingo 25 a las 00:00</span></span>
    <span class="rrdb__count" aria-hidden="true">
      <span><b data-d>0</b><i>días</i></span><span><b data-h>00</b><i>horas</i></span><span><b data-m>00</b><i>min</i></span><span><b data-x>00</b><i>seg</i></span>
    </span>
    <span class="rrdb__btn" data-b>Anotarme →</span>
    <span class="rrdb__legal">Fumar causa cáncer. Prohibida su venta a menores de 18 años.</span>
  </span>
</a>
<style>
  .rrdb{--g:#c9a35a;--ink:#f4efe6;--mut:#b9b3a8;display:grid;grid-template-columns:1.05fr 1fr;width:calc(100% - 32px);max-width:1200px;margin:20px auto;border-radius:18px;overflow:hidden;text-decoration:none;color:var(--ink);background:radial-gradient(90% 120% at 0% 0%,#1c3260 0%,#0a1222 55%) #0a1222;border:1px solid rgba(201,163,90,.5);box-shadow:0 18px 50px rgba(0,0,0,.45);transition:transform .25s ease,box-shadow .25s ease}
  .rrdb:hover{transform:translateY(-3px);box-shadow:0 24px 60px rgba(0,0,0,.55)}
  .rrdb__media{order:2;position:relative;min-height:300px}
  .rrdb__media img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
  .rrdb__media::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,#0a1222 0%,rgba(10,18,34,0) 38%)}
  .rrdb__body{order:1;display:flex;flex-direction:column;justify-content:center;align-items:flex-start;gap:14px;padding:clamp(24px,4vw,46px)}
  .rrdb__kicker{font:600 12px/1.2 var(--font-body-family,sans-serif);letter-spacing:.22em;text-transform:uppercase;color:var(--g)}
  .rrdb__title{display:block;font:600 clamp(32px,4.4vw,54px)/1.02 'Cormorant Garamond',Georgia,serif;color:var(--ink)}
  .rrdb__title em{font-style:italic;color:var(--g)}
  .rrdb__sub{display:block;max-width:44ch;font:400 15px/1.55 var(--font-body-family,sans-serif);color:var(--mut)}
  .rrdb__when{display:none}
  .rrdb__count{display:flex;gap:8px}
  .rrdb__count>span{min-width:58px;padding:9px 6px 7px;border:1px solid rgba(201,163,90,.6);border-radius:10px;text-align:center;background:rgba(255,255,255,.03)}
  .rrdb__count b{display:block;font:700 28px/1 'Cormorant Garamond',Georgia,serif;font-variant-numeric:lining-nums tabular-nums;color:var(--ink)}
  .rrdb__count i{display:block;margin-top:4px;font:600 9px/1 var(--font-body-family,sans-serif);font-style:normal;letter-spacing:.18em;text-transform:uppercase;color:var(--g)}
  .rrdb__btn{display:inline-block;padding:14px 24px;border-radius:999px;background:var(--g);color:#0a1222;font:700 14px/1 var(--font-body-family,sans-serif);letter-spacing:.08em;text-transform:uppercase}
  .rrdb:hover .rrdb__btn{background:#d9b56a}
  .rrdb__legal{font:400 11px/1.3 var(--font-body-family,sans-serif);color:var(--mut)}
  .rrdb.is-open .rrdb__count{display:none}
  /* Celular: franja compacta, foto de fondo y cuenta regresiva al lado del botón */
  @media (max-width:749px){
    .rrdb{position:relative;display:block;width:calc(100% - 24px);margin:10px auto;border-radius:14px;background:#0a1222}
    .rrdb:hover{transform:none}
    .rrdb__media{position:absolute;inset:0;min-height:0}
    .rrdb__media img{object-position:78% 50%}
    .rrdb__media::after{background:linear-gradient(90deg,rgba(10,18,34,.95) 0%,rgba(10,18,34,.84) 50%,rgba(10,18,34,.42) 100%)}
    .rrdb__body{position:relative;display:grid;grid-template-columns:1fr auto;align-items:end;column-gap:10px;row-gap:4px;padding:13px 14px 12px}
    .rrdb__kicker,.rrdb__title,.rrdb__sub,.rrdb__when,.rrdb__legal{grid-column:1/-1}
    .rrdb__kicker{font-size:9.5px;letter-spacing:.14em}
    .rrdb__title{font-size:27px}
    .rrdb__sub{display:none}
    .rrdb__when{display:block;font:500 12.5px/1.35 var(--font-body-family,sans-serif);color:var(--ink)}
    .rrdb__count{grid-column:1;gap:5px;margin-top:6px}
    .rrdb__count>span{min-width:0;flex:1;padding:5px 2px 4px;border-radius:8px}
    .rrdb__count b{font-size:19px}
    .rrdb__count i{margin-top:2px;font-size:7px;letter-spacing:.06em}
    .rrdb__btn{grid-column:2;margin-top:6px;padding:12px 14px;font-size:11.5px;letter-spacing:.06em;white-space:nowrap}
    .rrdb__legal{margin-top:4px}
    .rrdb.is-open .rrdb__when{display:none}
    .rrdb.is-open .rrdb__sub{display:block;font-size:13px}
    .rrdb.is-open .rrdb__btn{grid-column:1/-1;justify-self:start}
  }
</style>
<script>
  (function () {
    var el = document.getElementById('rrdb');
    if (!el) return;
    var start = Date.parse(el.getAttribute('data-start'));
    var sold = el.getAttribute('data-soldout') === '1';
    function q(s) { return el.querySelector(s); }
    function pad(n) { return (n < 10 ? '0' : '') + n; }
    if (!isNaN(start)) {
      try {
        var parts = {};
        new Intl.DateTimeFormat('es-AR', { weekday: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit', hourCycle: 'h23', timeZone: 'America/Argentina/Buenos_Aires' })
          .formatToParts(new Date(start)).forEach(function (p) { parts[p.type] = p.value; });
        var whenText = parts.weekday + ' ' + parts.day + ' a las ' + parts.hour + ':' + parts.minute;
        el.querySelectorAll('[data-when]').forEach(function (w) { w.textContent = whenText; });
      } catch (e) {}
    }
    function tick() {
      var now = Date.now();
      if (isNaN(start) || now >= start) {
        el.classList.add('is-open');
        if (sold) {
          q('[data-t]').innerHTML = 'Se agotaron los <em>bicapa</em>';
          q('[data-s]').textContent = 'Gracias a todos. Anotate y te avisamos del próximo lanzamiento.';
          q('[data-b]').textContent = 'Anotarme al próximo →';
        } else {
          q('[data-t]').innerHTML = 'Ya están disponibles los <em>bicapa</em>';
          q('[data-s]').textContent = 'Edición Especial. Máximo 10 por compra, hasta agotar stock.';
          q('[data-b]').textContent = 'Comprar mi bicapa →';
        }
        clearInterval(timer);
        return;
      }
      var s = Math.floor((start - now) / 1000);
      q('[data-d]').textContent = Math.floor(s / 86400);
      q('[data-h]').textContent = pad(Math.floor((s % 86400) / 3600));
      q('[data-m]').textContent = pad(Math.floor((s % 3600) / 60));
      q('[data-x]').textContent = pad(s % 60);
    }
    var timer = setInterval(tick, 1000);
    tick();
  })();
</script>
